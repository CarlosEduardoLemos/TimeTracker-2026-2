DATABASE_URL=postgresql://timetracker:timetracker@db:5432/timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=timetracker
POSTGRES_DB=timetracker

MAX_IDLE_SECONDS=300

# Autenticação do gestor (JWT)
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Mínimo de 32 caracteres. Se ficar vazia, uma chave temporária é gerada a cada
# inicialização (os tokens deixam de valer ao reiniciar). Defina em produção.
JWT_SECRET_KEY=
# Validade do token de acesso, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Validade do token do Agente Desktop, em minutos (padrão: 30 dias).
AGENT_TOKEN_EXPIRE_MINUTES=43200
